# AUTOSAR HLD Document Analysis Assistant Configuration

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# LLM Provider Configuration
# Supported providers: "mock", "openai", "anthropic", "local"
LLM_PROVIDER=mock

# OpenAI API Key & Model (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key & Model (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Local / Private LLM Endpoint (e.g., Ollama or vLLM running inside enterprise boundary)
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:8b

# Embedding Model (runs locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Paths
DATA_DIR=app/data
CHROMA_PERSIST_DIR=app/data/chroma_db
SQLITE_DB_PATH=app/data/autosar_analysis.db
UPLOAD_DIR=app/data/uploads

# Tesseract OCR Path (optional override if not in system PATH on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
