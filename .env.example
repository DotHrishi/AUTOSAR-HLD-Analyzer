# AUTOSAR HLD Document Analysis Assistant Configuration

# Backend Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000

# Security
# Set AUTOSAR_API_KEY to a strong random string to enable API key authentication.
# Leave empty to disable auth (local dev only).
AUTOSAR_API_KEY=

# Comma-separated list of origins allowed to call the API.
# For Docker Compose, add http://frontend:8501
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# LLM Provider Configuration
# Supported providers: "groq", "openai", "anthropic", "local", "mock"
LLM_PROVIDER=groq

# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI API Key & Model (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key & Model (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620

# Local / Private LLM Endpoint
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=llama3:8b

# Embedding Model (runs locally)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Paths
DATA_DIR=app/data
CHROMA_PERSIST_DIR=app/data/chroma_db
SQLITE_DB_PATH=app/data/autosar_analysis.db
UPLOAD_DIR=app/data/uploads
